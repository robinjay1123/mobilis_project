{
  "installCommand": "bash vercel_install.sh",
  "buildCommand": "./flutter/bin/flutter build web --release --base-href / --no-tree-shake-icons",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [

    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}